# 上游 Univer SDK(按用户要求纳入本项目仓库,vendored 源码)
# univer-dev/  ← 不再忽略

# 依赖
node_modules/

# Excel 示例(含真实经营数据,默认不入库;如需入库请手动取消忽略)
Excel_exampel/

# 本地配置
.claude/

# 系统/编辑器
.DS_Store
Thumbs.db
*.log
*.local
# Office 临时锁文件
~$*

# 构建产物
dist/
build/
.next/
.turbo/
# 打包的构建产物
*.tar.gz

# ===== 媒体发布微服务 (media-publisher) =====
# Python 虚拟环境
media-publisher/venv/
# Python 缓存
__pycache__/
*.pyc
# 敏感文件: Cookie(平台登录凭据,禁止入库)、本地配置
media-publisher/cookiesFile/
media-publisher/.env
# 运行时数据: SQLite 数据库、上传的媒体文件
media-publisher/**/*.db
media-publisher/db/
media-publisher/videoFile/
# 调试残留
media-publisher/*.txt

# 服务器上传目录(企业 logo / 业务 logo 等运行时文件)
server/uploads/
